<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <Nullable>enable</Nullable>
    <AssemblyName>IOF</AssemblyName>
    <RootNamespace>IOF</RootNamespace>
  </PropertyGroup>

  <!--
    Set QuantowerPath to your Quantower installation folder, e.g.:
      <QuantowerPath>C:\Program Files\Quantower</QuantowerPath>
    Or define it as an environment variable.
  -->
  <PropertyGroup>
    <QuantowerPath Condition="'$(QuantowerPath)' == ''">C:\Program Files\Quantower</QuantowerPath>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="TradingPlatform.BusinessLayer">
      <HintPath>$(QuantowerPath)\TradingPlatform.BusinessLayer.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

</Project>
